# Skiniify Configuration (Optional Environment Variables)
# Copy this to .env and fill in your values if you want to enable features

# Steam API Key (optional - not strictly needed for MVP)
# Get from: https://steamcommunity.com/dev/getkey.php
STEAM_API_KEY=

# CSFloat API Key (for additional price source)
CSFLOAT_API_KEY=

# Buff.market API Key (advanced pricing data)
BUFFMARKET_API_KEY=

# Application Settings
APP_PORT=8000
DEBUG_MODE=true

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Database Connection (Optional - for MVP you can skip this)
# DATABASE_URL=postgresql://user:password@localhost/skiniify

# Redis Cache URL (Optional - improves performance)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (comma-separated, leave empty for local development)
ALLOWED_ORIGINS=localhost,127.0.0.1